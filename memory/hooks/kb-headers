#!/bin/sh
# kb-headers: Claude Code's headersHelper for the kb MCP server. It prints where this Claude Code runs, as JSON headers:
#   {"X-KB-Cwd": "<its directory>", "X-KB-Repo": "<the git repo it is in>"}
# Claude Code runs it from your home directory, so the directory is its parent's, the claude process that called it.
# A ${PWD} header can't do this: the desktop app starts Claude Code with no PWD, and Claude Code drops the whole
# server when a header isn't ASCII, so both values go out percent-encoded and the server decodes them.
# Anything it can't find stays out. kb-hook's PostToolUse fills the gap from the hook's own cwd.
pid=$PPID
# A shell between Claude Code and this script started in your home directory too. Look past it.
case $(ps -o comm= -p "$pid" 2>/dev/null) in
  sh|*/sh|bash|*/bash|dash|*/dash|zsh|*/zsh) pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') ;;
esac
cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
case $cwd in /*) ;; *) echo '{}'; exit 0 ;; esac

# Every byte outside A-Z a-z 0-9 / . _ ~ - as %XX, the % sign included.
pct() {
  printf '%s' "$1" | od -An -v -tx1 | tr -s ' \t\n' '\n' | awk 'BEGIN { x = "0123456789abcdef" } NF {
    n = (index(x, substr($1, 1, 1)) - 1) * 16 + index(x, substr($1, 2, 1)) - 1
    if ((n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n == 46 || n == 47 || n == 95 || n == 126)
      printf "%c", n
    else
      printf "%%%s", toupper($1)
  }'
}

# The repo is its main checkout's folder, so a worktree under .claude/worktrees reports the repo it belongs to.
repo=
common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && case $common in
  */.git) repo=$(basename "${common%/.git}") ;;
  *) top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) && repo=$(basename "$top") ;;
esac
printf '{"X-KB-Cwd": "%s"' "$(pct "$cwd")"
[ -n "$repo" ] && printf ', "X-KB-Repo": "%s"' "$(pct "$repo")"
printf '}\n'
