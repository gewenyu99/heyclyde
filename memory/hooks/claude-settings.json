{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "~/.config/kb/kb-hook SessionStart" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "~/.config/kb/kb-hook UserPromptSubmit" }] }],
    "PostToolUse": [{ "matcher": "mcp__kb__.*", "hooks": [{ "type": "command", "command": "~/.config/kb/kb-hook PostToolUse" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "~/.config/kb/kb-hook Stop" }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "~/.config/kb/kb-hook PreCompact" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "~/.config/kb/kb-hook SessionEnd" }] }]
  }
}
