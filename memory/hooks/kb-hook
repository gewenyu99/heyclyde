#!/bin/sh
# kb-hook <event>: forward a Claude Code hook payload (stdin) to the memory server.
# It never loads memory into context and never blocks the agent: no config, a slow server or an error all exit 0.
[ -n "$1" ] && [ -n "$KB_URL" ] && [ -n "$KB_TOKEN" ] || exit 0
curl -sS -m 3 -o /dev/null -X POST "$KB_URL/hooks/$1" \
  -H "Authorization: Bearer $KB_TOKEN" -H "Content-Type: application/json" --data-binary @- 2>/dev/null
exit 0
