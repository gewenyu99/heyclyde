{
  "hooks": {
    "SessionStart": [{ "matcher": "startup|resume", "hooks": [{ "type": "command", "command": "~/.config/memory/clyde-hook.sh codex SessionStart" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "~/.config/memory/clyde-hook.sh codex UserPromptSubmit" }] }],
    "PreToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "~/.config/memory/clyde-hook.sh codex PreToolUse" }] }],
    "PostToolUse": [{ "matcher": "mcp__.*", "hooks": [{ "type": "command", "command": "~/.config/memory/clyde-hook.sh codex PostToolUse" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "~/.config/memory/clyde-hook.sh codex Stop" }] }]
  }
}
